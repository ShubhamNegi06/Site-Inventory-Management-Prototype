# --- Database (Supabase Postgres connection string) ---
# Supabase Project Settings -> Database -> Connection string -> URI (use "Session" pooler for backend)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key   # same value as the frontend's NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-project-settings-api   # optional -- only used as a fallback if JWKS verification fails
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # used only server-side to create users

# --- Cloudflare R2 (S3-compatible storage) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=inventory-reports
R2_ENDPOINT_URL=https://[R2_ACCOUNT_ID].r2.cloudflarestorage.com
R2_PUBLIC_URL=  # optional, only if bucket/dev-domain is public; otherwise we use presigned URLs

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
